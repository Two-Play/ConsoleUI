import { Theme } from "theme.slint";
import { ControllerStyle, GlyphButton } from "types.slint";
import { GlassPanel } from "glass.slint";
import { HintBar } from "glyph.slint";
import { Button } from "button.slint";

// Modal alert/confirmation dialog: dimmed backdrop, a glass card with title, text and one to three
// buttons in a row. State and input live in `consoleui_core::dialog::Dialog`; Rust fills the
// properties. Left/Right and the button hints are handled by the shell like on every other layer.
export component Dialog inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> text;
    in property <[string]> buttons;
    in property <int> focused;
    in property <ControllerStyle> style;
    in property <float> s: 1;

    callback button-clicked(int);

    property <length> pad: 44px * root.s;

    // Where the card is in this window, for the compositor's backdrop blur (Story 7.13)
    out property <length> panel-x: panel.x;
    out property <length> panel-y: panel.y;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <length> panel-radius: panel.border-radius;

    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b3;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Theme.page-duration; }
    }

    panel := GlassPanel {
        opacity: root.open ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: Theme.page-duration; }
        width: 680px * root.s;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 24px * root.s;

        content := VerticalLayout {
            padding: root.pad;
            spacing: 14px * root.s;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 34px * root.s;
                font-weight: 800;
                wrap: word-wrap;
            }

            Text {
                text: root.text;
                color: Theme.text-dim;
                font-size: 22px * root.s;
                wrap: word-wrap;
            }

            HorizontalLayout {
                padding-top: 12px * root.s;
                spacing: 12px * root.s;
                alignment: end;

                for label[i] in root.buttons: Button {
                    text: label;
                    focused: i == root.focused;
                    s: root.s;
                    clicked => { root.button-clicked(i); }
                }
            }

            HintBar {
                padding-top: 6px * root.s;
                hints: root.buttons.length > 1
                    ? [{ button: GlyphButton.confirm, label: @tr("Select") }, { button: GlyphButton.back, label: @tr("Cancel") }]
                    : [{ button: GlyphButton.confirm, label: @tr("OK") }];
                style: root.style;
                s: root.s;
            }
        }
    }
}

import { Theme } from "theme.slint";
import { GlassPanel } from "glass.slint";

// Short notice at the top right, e.g. "Controller connected". Slides in and fades out.
export component Toast inherits GlassPanel {
    in property <bool> shown;
    in property <string> symbol;
    in property <string> title;
    in property <string> text;
    // A cover instead of the symbol, e.g. for "now playing"
    in property <image> picture;
    in property <bool> has-picture;
    in property <float> s: 1;

    width: 440px * root.s;
    height: 86px * root.s;
    border-radius: Theme.radius-card * root.s;
    drop-shadow-blur: 30px * root.s;
    drop-shadow-color: #00000099;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: Theme.page-duration * 1.5; }

    HorizontalLayout {
        padding-left: 22px * root.s;
        padding-right: 22px * root.s;
        spacing: 18px * root.s;

        if root.has-picture: Rectangle {
            horizontal-stretch: 0;
            width: 58px * root.s;
            height: 58px * root.s;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-card * 0.6 * root.s;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.picture;
                image-fit: cover;
            }
        }

        if !root.has-picture: Text {
            horizontal-stretch: 0;
            text: root.symbol;
            color: Theme.accent;
            font-size: 30px * root.s;
            vertical-alignment: center;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px * root.s;

            Text {
                text: root.title;
                color: Theme.text;
                font-size: 20px * root.s;
                font-weight: 700;
                overflow: elide;
            }

            if root.text != "": Text {
                text: root.text;
                color: Theme.text-dim;
                font-size: 16px * root.s;
                overflow: elide;
            }
        }
    }
}

import { Theme } from "theme.slint";
import { ControllerStyle, GlyphButton, Hint, KeyCap } from "types.slint";
import { GlassPanel } from "glass.slint";
import { ButtonGlyph, HintBar } from "glyph.slint";
import { FocusRing } from "focusring.slint";
import { OnScreenKeyboard, TextField } from "keyboard.slint";

// The on-screen keyboard as a floating glass panel, for text entry in the shell and over apps. It
// fills the layer it sits in (a window of its own over a game, or a layer of the main window) and
// places the panel by `place-x` / `place-y` (0 to 1 of the free space, see
// `consoleui_core::placement`). R3 grabs the panel (`moving`), the directions then move it.
export component KeyboardPanel inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> text;
    in property <string> placeholder;
    in property <[KeyCap]> keys;
    in property <int> focused;
    // No key is highlighted while the selection is elsewhere (e.g. on the search results)
    in property <bool> keys-active: true;
    // Placement: 0 left/top edge, 1 right/bottom edge
    in property <float> place-x: 0.5;
    in property <float> place-y: 0.94;
    // Grabbed with R3: the panel gets the accent outline and the move hints
    in property <bool> moving;
    // Hints next to the move hint, e.g. what the square button does
    in property <[Hint]> hints;
    in property <ControllerStyle> style;
    in property <float> s: 1;

    property <length> unit: 52px * root.s;
    property <length> pad: 26px * root.s;

    // Where the panel is in this window, for the compositor's backdrop blur (Story 7.13)
    out property <length> panel-x: panel.x;
    out property <length> panel-y: panel.y;
    out property <length> panel-width: panel.width;
    out property <length> panel-height: panel.height;
    out property <length> panel-radius: panel.border-radius;

    panel := GlassPanel {
        width: 11 * root.unit + 2 * root.pad;
        height: root.pad + 42px * root.s + 56px * root.s + 16px * root.s + 5 * root.unit + 6px * root.s + 36px * root.s + root.pad / 2;
        x: (root.width - self.width) * clamp(root.place-x, 0, 1);
        y: (root.height - self.height) * clamp(root.place-y, 0, 1);
        border-radius: 24px * root.s;
        opacity: root.open ? 1 : 0;
        visible: self.opacity > 0.01;
        animate x, y { duration: Theme.focus-duration * 0.8; easing: ease-out-quint; }
        animate opacity { duration: Theme.page-duration; }
        drop-shadow-blur: 40px * root.s;
        drop-shadow-color: #000000aa;

        Text {
            x: root.pad;
            y: root.pad - 6px * root.s;
            width: parent.width - 2 * root.pad - 190px * root.s;
            text: root.title;
            color: Theme.text-dim;
            font-size: 20px * root.s;
            font-weight: 600;
            overflow: elide;
        }

        // R3 moves the keyboard
        HorizontalLayout {
            x: parent.width - root.pad - self.preferred-width;
            y: root.pad - 10px * root.s;
            height: 28px * root.s;
            spacing: 8px * root.s;
            opacity: root.moving ? 0 : 1;

            ButtonGlyph {
                y: (parent.height - self.height) / 2;
                button: GlyphButton.r3;
                style: root.style;
                s: root.s * 0.85;
            }

            Text {
                text: @tr("Move");
                color: Theme.text-dim;
                font-size: 16px * root.s;
                vertical-alignment: center;
            }
        }

        TextField {
            x: root.pad;
            y: root.pad + 42px * root.s - 6px * root.s;
            width: 11 * root.unit - 8px * root.s;
            height: 56px * root.s;
            text: root.text;
            placeholder: root.placeholder;
            s: root.s;
        }

        OnScreenKeyboard {
            x: root.pad;
            y: root.pad + 42px * root.s - 6px * root.s + 56px * root.s + 16px * root.s;
            keys: root.keys;
            focused: root.focused;
            active: root.keys-active && !root.moving;
            unit: root.unit;
            s: root.s;
        }

        HintBar {
            x: root.pad;
            y: parent.height - root.pad / 2 - 32px * root.s;
            height: 28px * root.s;
            style: root.style;
            s: root.s;
            spacing: 20px * root.s;
            hints: root.moving ? [{ button: GlyphButton.dpad, label: @tr("Move") }, { button: GlyphButton.confirm, label: @tr("Drop") }]
                : root.hints;
        }

        if root.moving: FocusRing {
            border-radius: panel.border-radius;
            focused: true;
            s: root.s;
        }
    }
}

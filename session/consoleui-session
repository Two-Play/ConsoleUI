#!/bin/sh
# ConsoleUI als Konsolen-Session: gamescope im Steam-Modus (-e) mit der Shell als Hauptprogramm.
# Die Shell übernimmt dabei die Rolle von Steam: Sie gibt allen Fenstern App-IDs und bestimmt,
# was vorne ist (siehe docs/spike-gamescope.md). Endet die Shell, endet auch die Session.
#
# Umgebungsvariablen:
#   CONSOLEUI_BIN             Pfad zur Shell (Standard: /usr/local/bin/consoleui)
#   CONSOLEUI_GAMESCOPE_ARGS  zusätzliche gamescope-Optionen, z. B. "-W 3840 -H 2160 --adaptive-sync"
set -eu

bin="${CONSOLEUI_BIN:-/usr/local/bin/consoleui}"
export CONSOLEUI_GAMESCOPE=steam
# shellcheck disable=SC2086 # Die Optionen sollen bewusst in Wörter zerlegt werden.
exec gamescope -e ${CONSOLEUI_GAMESCOPE_ARGS:-} -- "$bin" "$@"

import { Theme } from "theme.slint";

// Round profile picture: the initial on a gradient of the profile color.
export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint: #7c5cff;
    in property <length> size: 36px;
    in property <float> s: 1;

    width: root.size;
    height: root.size;
    border-radius: self.width / 2;
    background: @linear-gradient(135deg, root.tint.brighter(0.25) 0%, root.tint.darker(0.35) 100%);

    Text {
        width: 100%;
        height: 100%;
        text: root.initial;
        color: Theme.text;
        font-size: root.size * 0.5;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

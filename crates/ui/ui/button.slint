import { Theme } from "theme.slint";

// The standard button: a rounded pill that fills with the accent color while it has the focus.
// Focus comes from Rust (gamepad navigation), not from Slint's focus handling.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> focused;
    in property <float> s: 1;

    callback clicked();

    min-width: 150px * root.s;
    preferred-width: label.preferred-width + 56px * root.s;
    height: 58px * root.s;
    border-radius: 16px * root.s;
    background: root.focused ? Theme.accent : Theme.surface.with-alpha(0.08);
    animate background { duration: Theme.focus-duration; easing: ease-out-quart; }

    TouchArea {
        clicked => { root.clicked(); }
    }

    label := Text {
        text: root.text;
        color: root.focused ? Theme.base : Theme.text;
        font-size: 24px * root.s;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

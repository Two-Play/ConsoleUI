import { Theme } from "theme.slint";
import { ContextItem } from "types.slint";
import { GlassPanel } from "glass.slint";
import { FocusFill } from "focusfill.slint";
import { FocusRing } from "focusring.slint";

// Context menu for the focused entry: a small card in the centre like the quit confirmation,
// with rows like the cards of the quick menu. The button hints are in the hint bar.
export component ContextMenu inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <[ContextItem]> items;
    in property <int> focused;
    in property <float> s: 1;

    property <length> row-height: 64px * root.s;
    property <length> pad: 28px * root.s;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.scrim;
        opacity: root.open ? 1 : 0;
        animate opacity { duration: Theme.page-duration; }
    }

    if root.open: panel := GlassPanel {
        width: 520px * root.s;
        height: 2 * root.pad + 52px * root.s + root.items.length * (root.row-height + 8px * root.s);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-panel * root.s;

        Text {
            x: root.pad + 6px * root.s;
            y: root.pad;
            width: parent.width - 2 * root.pad;
            text: root.title;
            color: Theme.text-dim;
            font-size: 20px * root.s;
            font-weight: 600;
            letter-spacing: 2px * root.s;
            overflow: elide;
        }

        for item[i] in root.items: Rectangle {
            property <bool> is-focused: i == root.focused;
            x: root.pad;
            y: root.pad + 52px * root.s + i * (root.row-height + 8px * root.s);
            width: parent.width - 2 * root.pad;
            height: root.row-height;
            border-radius: Theme.radius-button * root.s;
            background: Theme.surface.with-alpha(0.06);

            fill := FocusFill {
                width: 100%;
                height: 100%;
                border-radius: parent.border-radius;
                focused: parent.is-focused;
            }

            FocusRing {
                border-radius: parent.border-radius;
                focused: parent.is-focused;
                s: root.s;
            }

            Text {
                x: 22px * root.s;
                width: 32px * root.s;
                height: 100%;
                text: item.symbol;
                color: Theme.text;
                font-size: 24px * root.s;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                x: 72px * root.s;
                width: parent.width - 90px * root.s;
                height: 100%;
                text: item.label;
                color: Theme.text;
                font-size: 22px * root.s;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

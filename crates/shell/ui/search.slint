import { AppTile } from "types.slint";
import { Theme } from "@consoleui/theme.slint";
import { TileRow } from "@consoleui/tilerow.slint";

// Search: the results as a row of tiles; the text field and the keyboard are the floating `KeyboardPanel` of the main window.
export component SearchPage inherits Rectangle {
    in property <string> query;
    in property <bool> keyboard-active: true;
    in property <[AppTile]> results;
    in property <int> result-focused;
    in property <bool> pulse;
    in property <float> s;

    out property <length> focus-x: row.focus-x;
    out property <length> focus-y: row.focus-y;
    out property <length> focus-size: row.focus-size;

    property <length> margin: 110px * root.s;

    Text {
        x: root.margin;
        y: 120px * root.s;
        // Own msgid: "Search" is the hint (German "Suchen"), the heading is a noun ("Suche").
        text: @tr("Find");
        color: Theme.text;
        font-size: 44px * root.s;
        font-weight: 800;
    }

    Text {
        x: root.margin;
        y: 200px * root.s;
        text: root.query == "" ? @tr("Recently used") : root.results.length == 0 ? @tr("No results") : @tr("{n} result" | "{n} results" % root.results.length);
        color: Theme.text-dim;
        font-size: 20px * root.s;
    }

    row := TileRow {
        x: root.margin;
        y: 250px * root.s;
        tiles: root.results;
        focused: root.result-focused;
        active: !root.keyboard-active;
        pulse: root.pulse;
        tile: 130px * root.s;
        tile-focused: 190px * root.s;
        gap: 18px * root.s;
    }
}

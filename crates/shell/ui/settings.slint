import { SettingRow } from "types.slint";
import { SettingList } from "@consoleui/settinglist.slint";
import { Theme } from "@consoleui/theme.slint";

// Settings page: heading plus the list of rows; see `SettingList`. The list ends a little above the hint bar.
export component SettingsPage inherits Rectangle {
    in property <[SettingRow]> rows;
    in property <int> focused;
    in property <string> footer;
    // The focused row is highlighted (off while the selection is on the tabs)
    in property <bool> active: true;

    callback row-clicked(int);
    in property <float> s;

    property <length> margin: 110px * root.s;

    Text {
        x: root.margin;
        y: 120px * root.s;
        text: @tr("Settings");
        color: Theme.text;
        font-size: 44px * root.s;
        font-weight: 800;
    }

    SettingList {
        x: root.margin;
        y: 200px * root.s;
        width: root.width - 2 * root.margin;
        height: root.height - 200px * root.s - 150px * root.s;
        rows: root.rows;
        focused: root.focused;
        footer: root.footer;
        active: root.active;
        s: root.s;
        row-clicked(i) => { root.row-clicked(i); }
    }
}

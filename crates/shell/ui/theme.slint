// Zentrale Design-Tokens (Farben, Timings). Alle Komponenten lesen von hier.
export global Theme {
    out property <color> base: #06070c;
    out property <color> text: #f4f6fb;
    out property <color> text-dim: #f4f6fb99;
    out property <color> surface: #ffffff1f;

    out property <duration> focus-duration: 220ms;
    out property <duration> background-duration: 500ms;
    out property <duration> pulse-duration: 120ms;
}

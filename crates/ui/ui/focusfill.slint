import { Theme } from "theme.slint";

// The accent fill of a focused list entry, card or button. The focus (the outline of the entry,
// drawn by the entry itself) moves right away; the fill follows a moment later: it fades in
// (ease-out-quint) after a short delay when the entry gets the focus, and the entry that loses
// the focus empties at once, so the fill trails the focus from one entry to the next. Put it first in a rounded entry (give it the
// entry's `border-radius`) and draw the outline on top. The text keeps its color.
export component FocusFill inherits Rectangle {
    in property <bool> focused;
    // Only a light wash of the accent color: the outline carries the focus
    in property <color> fill: Theme.accent.with-alpha(0.16);
    // 0 empty, 1 full
    out property <float> level: root.focused ? 1 : 0;

    background: root.fill;
    opacity: clamp(root.level, 0, 1);
    visible: root.level > 0.002;
    animate level {
        delay: root.focused ? Theme.focus-duration * 0.45 : 0ms;
        duration: root.focused ? Theme.focus-duration : Theme.focus-duration * 0.6;
        easing: ease-out-quint;
    }
}

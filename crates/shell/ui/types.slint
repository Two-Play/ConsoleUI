// Input-agnostic actions; Rust maps them to `consoleui_core::Action`.
export enum NavAction { up, down, left, right, confirm, back, menu, search, secondary, prev-tab, next-tab, guide }

export enum NetworkState { offline, ethernet, wifi }

export enum Screen { home, library, settings, search }

// Which button a hint shows; the glyph depends on the ControllerStyle.
export enum GlyphButton { dpad, updown, confirm, back, north, west, menu, guide, l1, r1, quit }

export enum ControllerStyle { keyboard, playstation, xbox }

export struct Hint {
    button: GlyphButton,
    label: string,
}

export struct AppTile {
    title: string,
    subtitle: string,
    kind: string,
    action-label: string,
    monogram: string,
    // Only for placeholder covers without an icon
    show-monogram: bool,
    // Real cover or generated gradient
    cover: image,
    icon: image,
    has-icon: bool,
    logo: image,
    has-logo: bool,
    accent: color,
    running: bool,
    // Pinned in the context menu: comes first in home and carries a pin
    pinned: bool,
}

// Context menu item (pin, hide, ...)
export struct ContextItem {
    label: string,
    // Symbol as text (monochrome)
    symbol: string,
}

// On-screen keyboard key; position and width in key widths
export struct KeyCap {
    label: string,
    row: int,
    x: float,
    width: float,
}

// Quick menu item
export struct QuickItem {
    label: string,
    // Detail below the name, e.g. "30 %"
    value: string,
    // Symbol as text (monochrome), e.g. "⏻"
    symbol: string,
    // Waiting for the second confirmation (power off, quit, ...)
    armed: bool,
    // Volume: up/down adjusts
    adjustable: bool,
    // 0-100 for the bar, otherwise -1
    level: int,
}

// Row of the settings page
export struct SettingRow {
    label: string,
    description: string,
    value: string,
    // Opens a sub-page (Wi-Fi, Bluetooth) instead of changing the value
    opens-page: bool,
}

// Row of the Wi-Fi or Bluetooth page
export struct NetRow {
    // Symbol as text (Bluetooth device kind, on/off)
    symbol: string,
    title: string,
    detail: string,
    // On the right, e.g. "On"
    value: string,
    // Wi-Fi signal 1-4, otherwise 0
    bars: int,
    secured: bool,
    // Highlight controllers
    gamepad: bool,
    // Connected
    active: bool,
    // Request running (connecting, pairing, ...)
    busy: bool,
    // Waiting for the second press to remove
    armed: bool,
}

// "Wi-Fi" or "Bluetooth" sub-page of the settings, including password entry
export struct NetView {
    open: bool,
    title: string,
    status: string,
    rows: [NetRow],
    focused: int,
    empty-title: string,
    empty-text: string,
    password-open: bool,
    password-ssid: string,
    password-text: string,
    keys: [KeyCap],
    key-focused: int,
}

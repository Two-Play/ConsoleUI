import { Theme } from "theme.slint";
import { AppTile, ControllerStyle, GlyphButton, Hint, KeyCap, NavAction, NetRow, NetView, NetworkState, QuickItem, Screen, SettingRow } from "types.slint";
import { StatusBar } from "statusbar.slint";
import { ButtonGlyph, HintBar } from "glyph.slint";
import { HomePage } from "home.slint";
import { LibraryPage } from "library.slint";
import { SearchPage } from "search.slint";
import { QuickMenu } from "quickmenu.slint";
import { OverlayWindow } from "overlay.slint";
import { SettingsPage } from "settings.slint";
import { NetworkPage } from "network.slint";
import { BootScreen } from "boot.slint";
import { Toast } from "toast.slint";

export { AppTile, ControllerStyle, GlyphButton, Hint, KeyCap, NavAction, NetRow, NetView, NetworkState, QuickItem, Screen, SettingRow, OverlayWindow, Theme }

export component AppWindow inherits Window {
    title: "ConsoleUI";
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.base;
    forward-focus: keys;

    in property <Screen> screen: Screen.home;
    // Hinweis oben rechts
    in property <bool> toast-shown;
    in property <string> toast-symbol;
    in property <string> toast-title;
    in property <string> toast-text;

    // Boot-Animation, bis die Bibliothek geladen ist
    in property <bool> booting: true;

    in property <[AppTile]> home-tiles;
    in property <int> home-focused;

    in property <[AppTile]> library-tiles;
    in property <int> library-focused;
    in property <string> filter-label;
    in property <string> sort-label;
    out property <int> library-columns: library.columns;

    in property <[SettingRow]> settings-rows;
    in property <int> settings-focused;
    in property <string> settings-footer;
    // Unterseite WLAN/Bluetooth der Einstellungen (Stories 5.3/5.4)
    in property <NetView> net-view;

    in property <string> search-query;
    in property <[KeyCap]> keys;
    in property <int> key-focused;
    in property <bool> keyboard-active: true;
    in property <[AppTile]> results;
    in property <int> result-focused;

    // Kurzer „Drück“-Effekt auf der fokussierten Kachel; setzt sich selbst zurück.
    in-out property <bool> pulse: false;
    in property <string> clock: "--:--";
    in property <bool> show-fps: false;
    in property <string> fps-text;

    // Hintergrundbild: zwei Ebenen, Rust lädt das neue Bild in die verdeckte und schaltet dann um.
    in property <image> hero-a;
    in property <image> hero-b;
    in property <bool> hero-front-a: true;

    // Startbildschirm: Die fokussierte Kachel zoomt auf Vollbild. Rust schließt ihn wieder, wenn die
    // App beendet ist (oder bei „Zurück“).
    in property <bool> launching: false;
    in property <string> launch-title;
    in property <string> launch-status;
    in property <image> launch-image;
    in property <color> launch-accent;

    // Quick-Menü als Ebene im Hauptfenster (ohne gamescope; dort ist es ein eigenes Overlay-Fenster)
    in property <bool> quick-open;
    in property <string> quick-title;
    in property <[QuickItem]> quick-items;
    in property <int> quick-focused;

    // Rückfrage, z. B. vor dem Beenden einer laufenden App
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;

    // Top-Bar-Status
    in property <NetworkState> network: NetworkState.offline;
    in property <int> battery-percent: -1;
    in property <bool> battery-charging;
    in property <bool> controller-connected;
    in property <int> controller-battery: -1;
    in property <ControllerStyle> controller-style: ControllerStyle.keyboard;
    in property <[Hint]> hints;

    // Nur mit Fokus nimmt die Shell Gamepad-Eingaben an; sonst gehören sie dem Spiel im Vordergrund.
    out property <bool> window-active: keys.has-focus;

    callback action(NavAction);
    // Tastatureingabe in der Suche; gibt zurück, ob das Zeichen angenommen wurde.
    callback typed(string) -> bool;
    callback erase();
    callback quit();

    // Alle Maße skalieren mit der Fenstergröße (Referenz: 1920×1080).
    property <float> s: max(0.4, min(root.width / 1920px, root.height / 1080px));
    property <length> margin: 110px * s;

    property <AppTile> current: root.screen == Screen.home ? root.home-tiles[root.home-focused]
        : root.screen == Screen.library ? root.library-tiles[root.library-focused]
        : root.screen == Screen.search ? root.results[root.result-focused]
        : root.home-tiles[0];
    property <color> glow: root.current.accent;
    animate glow {
        duration: Theme.background-duration;
        easing: ease-in-out;
    }

    Timer {
        interval: Theme.pulse-duration;
        running: root.pulse;
        triggered => {
            root.pulse = false;
        }
    }

    keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "q" || event.text == "Q") {
                    root.quit();
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.LeftArrow) {
                root.action(NavAction.left);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.action(NavAction.right);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.action(NavAction.up);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.action(NavAction.down);
                return accept;
            }
            if (event.text == Key.Return) {
                root.action(NavAction.confirm);
                return accept;
            }
            if (event.text == Key.Escape) {
                root.action(NavAction.back);
                return accept;
            }
            if (event.text == Key.Tab) {
                root.action(NavAction.menu);
                return accept;
            }
            if (event.text == Key.F1) {
                root.action(NavAction.guide);
                return accept;
            }
            // In der Suche (und der WLAN-Passwort-Eingabe) tippt die Tastatur; WASD und die
            // Buchstabenkürzel gelten dort nicht.
            if ((root.screen == Screen.search || (root.screen == Screen.settings && root.net-view.password-open))
                && !root.launching && !root.confirm-open) {
                if (event.text == Key.Backspace) {
                    root.erase();
                    return accept;
                }
                return root.typed(event.text) ? accept : reject;
            }
            if (event.text == "a") {
                root.action(NavAction.left);
                return accept;
            }
            if (event.text == "d") {
                root.action(NavAction.right);
                return accept;
            }
            if (event.text == "w") {
                root.action(NavAction.up);
                return accept;
            }
            if (event.text == "s") {
                root.action(NavAction.down);
                return accept;
            }
            if (event.text == Key.Space) {
                root.action(NavAction.confirm);
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.action(NavAction.back);
                return accept;
            }
            if (event.text == "m") {
                root.action(NavAction.menu);
                return accept;
            }
            if (event.text == "q") {
                root.action(NavAction.prev-tab);
                return accept;
            }
            if (event.text == "e") {
                root.action(NavAction.next-tab);
                return accept;
            }
            if (event.text == "/") {
                root.action(NavAction.search);
                return accept;
            }
            if (event.text == "f") {
                root.action(NavAction.secondary);
                return accept;
            }
            reject
        }

        // Hintergrund: Verlauf und Lichtschein in der Akzentfarbe der fokussierten App
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(160deg, root.glow.darker(0.4) 0%, Theme.base 70%);
        }

        Rectangle {
            x: root.width * 0.4;
            y: -root.height * 0.45;
            width: root.width * 0.95;
            height: self.width;
            background: @radial-gradient(circle, root.glow.with-alpha(0.45) 0%, transparent 65%);
        }

        // Hero-Artwork mit Überblendung
        Image {
            width: 100%;
            height: 100%;
            source: root.hero-a;
            image-fit: cover;
            opacity: root.hero-front-a ? 1 : 0;
            animate opacity {
                duration: Theme.background-duration;
                easing: ease-in-out;
            }
        }

        Image {
            width: 100%;
            height: 100%;
            source: root.hero-b;
            image-fit: cover;
            opacity: root.hero-front-a ? 0 : 1;
            animate opacity {
                duration: Theme.background-duration;
                easing: ease-in-out;
            }
        }

        // Abdunkeln von links und unten, damit Text auf jedem Artwork lesbar bleibt; in Bibliothek
        // und Suche stärker, weil dort mehr Text steht.
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(90deg, Theme.base.with-alpha(0.9) 0%, Theme.base.with-alpha(0.5) 45%, Theme.base.with-alpha(0.15) 100%);
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, Theme.base.with-alpha(0.5) 0%, transparent 30%, transparent 55%, Theme.base 100%);
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.base;
            opacity: root.screen == Screen.home ? 0 : 0.55;
            animate opacity { duration: Theme.page-duration; }
        }

        // Tabs
        HorizontalLayout {
            x: root.margin;
            y: 50px * s;
            width: self.preferred-width;
            height: 36px * s;
            spacing: 18px * s;

            ButtonGlyph {
                y: (parent.height - self.height) / 2;
                button: GlyphButton.l1;
                style: root.controller-style;
                s: root.s;
                opacity: root.screen == Screen.library || root.screen == Screen.settings ? 1 : 0.35;
            }

            Text {
                text: "Home";
                color: root.screen == Screen.home ? Theme.text : Theme.text-dim;
                font-size: 26px * s;
                font-weight: root.screen == Screen.home ? 700 : 600;
                vertical-alignment: center;
            }

            Text {
                text: "Bibliothek";
                color: root.screen == Screen.library ? Theme.text : Theme.text-dim;
                font-size: 26px * s;
                font-weight: root.screen == Screen.library ? 700 : 600;
                vertical-alignment: center;
            }

            Text {
                text: "Einstellungen";
                color: root.screen == Screen.settings ? Theme.text : Theme.text-dim;
                font-size: 26px * s;
                font-weight: root.screen == Screen.settings ? 700 : 600;
                vertical-alignment: center;
            }

            ButtonGlyph {
                y: (parent.height - self.height) / 2;
                button: GlyphButton.r1;
                style: root.controller-style;
                s: root.s;
                opacity: root.screen == Screen.home || root.screen == Screen.library ? 1 : 0.35;
            }
        }

        StatusBar {
            x: root.width - root.margin - self.width;
            y: 50px * s;
            s: root.s;
            clock: root.clock;
            network: root.network;
            battery-percent: root.battery-percent;
            battery-charging: root.battery-charging;
            controller-connected: root.controller-connected;
            controller-battery: root.controller-battery;
        }

        // Seiten mit kurzem Überblenden und leichtem Seitwärtsgleiten
        home := HomePage {
            width: root.width;
            height: root.height;
            x: root.screen == Screen.home ? 0 : -60px * s;
            opacity: root.screen == Screen.home ? 1 : 0;
            visible: self.opacity > 0.01;
            animate x, opacity {
                duration: Theme.page-duration;
                easing: ease-out-quart;
            }
            tiles: root.home-tiles;
            focused: root.home-focused;
            pulse: root.pulse && root.screen == Screen.home;
            s: root.s;
        }

        SettingsPage {
            width: root.width;
            height: root.height;
            x: root.screen == Screen.settings ? (root.net-view.open ? -60px * s : 0) : 60px * s;
            opacity: root.screen == Screen.settings && !root.net-view.open ? 1 : 0;
            visible: self.opacity > 0.01;
            animate x, opacity {
                duration: Theme.page-duration;
                easing: ease-out-quart;
            }
            rows: root.settings-rows;
            focused: root.settings-focused;
            footer: root.settings-footer;
            s: root.s;
        }

        NetworkPage {
            width: root.width;
            height: root.height;
            x: root.screen == Screen.settings && root.net-view.open ? 0 : 60px * s;
            opacity: root.screen == Screen.settings && root.net-view.open ? 1 : 0;
            visible: self.opacity > 0.01;
            animate x, opacity {
                duration: Theme.page-duration;
                easing: ease-out-quart;
            }
            view: root.net-view;
            s: root.s;
        }

        library := LibraryPage {
            width: root.width;
            height: root.height;
            x: root.screen == Screen.library ? 0 : root.screen == Screen.home ? 60px * s : -60px * s;
            opacity: root.screen == Screen.library ? 1 : 0;
            visible: self.opacity > 0.01;
            animate x, opacity {
                duration: Theme.page-duration;
                easing: ease-out-quart;
            }
            tiles: root.library-tiles;
            focused: root.library-focused;
            pulse: root.pulse && root.screen == Screen.library;
            s: root.s;
            filter-label: root.filter-label;
            sort-label: root.sort-label;
            style: root.controller-style;
        }

        search := SearchPage {
            width: root.width;
            height: root.height;
            y: root.screen == Screen.search ? 0 : 40px * s;
            opacity: root.screen == Screen.search ? 1 : 0;
            visible: self.opacity > 0.01;
            animate y, opacity {
                duration: Theme.page-duration;
                easing: ease-out-quart;
            }
            query: root.search-query;
            keys: root.keys;
            key-focused: root.key-focused;
            keyboard-active: root.keyboard-active;
            results: root.results;
            result-focused: root.result-focused;
            pulse: root.pulse && root.screen == Screen.search;
            s: root.s;
        }

        HintBar {
            x: root.margin;
            y: root.height - 70px * s;
            height: 28px * s;
            hints: root.hints;
            style: root.controller-style;
            s: root.s;
            opacity: root.quick-open ? 0 : 1;
            animate opacity { duration: Theme.page-duration; }
        }

        // Startbildschirm; liegt geschlossen unsichtbar genau über der fokussierten Kachel.
        Rectangle {
            property <length> origin-x: root.screen == Screen.home ? home.focus-x : root.screen == Screen.library ? library.focus-x : search.focus-x;
            property <length> origin-y: root.screen == Screen.home ? home.focus-y : root.screen == Screen.library ? library.focus-y : search.focus-y;
            property <length> origin-size: root.screen == Screen.home ? home.focus-size : root.screen == Screen.library ? library.focus-size : search.focus-size;

            x: self.origin-x;
            y: self.origin-y;
            width: self.origin-size;
            height: self.origin-size;
            border-radius: self.origin-size * 0.12;
            background: root.launch-accent;
            opacity: 0;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.launch-image;
                image-fit: cover;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(180deg, transparent 40%, #000000cc 100%);
            }

            VerticalLayout {
                alignment: end;
                padding: root.margin;
                spacing: 8px * s;

                Text {
                    text: root.launch-title;
                    color: Theme.text;
                    font-size: 56px * s;
                    font-weight: 800;
                }

                Text {
                    text: root.launch-status;
                    color: Theme.text-dim;
                    font-size: 26px * s;
                }

                HintBar {
                    padding-top: 10px * s;
                    hints: [{ button: GlyphButton.back, label: "Zur Übersicht" }];
                    style: root.controller-style;
                    s: root.s;
                }
            }

            states [
                open when root.launching: {
                    x: 0;
                    y: 0;
                    width: root.width;
                    height: root.height;
                    border-radius: 0;
                    opacity: 1;
                    in {
                        animate x, y, width, height, border-radius {
                            duration: Theme.launch-duration;
                            easing: ease-in-out-quart;
                        }
                        animate opacity { duration: 100ms; }
                    }
                    out {
                        animate x, y, width, height, border-radius, opacity {
                            duration: Theme.launch-duration;
                            easing: ease-in-out-quart;
                        }
                    }
                }
            ]
        }

        if root.confirm-open: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000b3;

            Rectangle {
                width: 680px * s;
                height: 270px * s;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 24px * s;
                background: #191b24;
                border-width: 1px;
                border-color: #ffffff22;

                VerticalLayout {
                    padding: 44px * s;
                    spacing: 14px * s;

                    Text {
                        text: root.confirm-title;
                        color: Theme.text;
                        font-size: 34px * s;
                        font-weight: 800;
                    }

                    Text {
                        text: root.confirm-text;
                        color: Theme.text-dim;
                        font-size: 22px * s;
                        wrap: word-wrap;
                    }

                    HintBar {
                        padding-top: 18px * s;
                        hints: [{ button: GlyphButton.confirm, label: "Beenden" }, { button: GlyphButton.back, label: "Abbrechen" }];
                        style: root.controller-style;
                        s: root.s;
                    }
                }
            }
        }

        QuickMenu {
            width: 100%;
            height: 100%;
            open: root.quick-open;
            title: root.quick-title;
            items: root.quick-items;
            focused: root.quick-focused;
            style: root.controller-style;
            s: root.s;
        }

        Toast {
            x: root.width - root.margin - self.width + (root.toast-shown ? 0 : 60px * s);
            y: 110px * s;
            animate x {
                duration: Theme.launch-duration;
                easing: ease-out-quart;
            }
            shown: root.toast-shown;
            symbol: root.toast-symbol;
            title: root.toast-title;
            text: root.toast-text;
            s: root.s;
        }

        BootScreen {
            width: 100%;
            height: 100%;
            active: root.booting;
            s: root.s;
        }

        if root.show-fps: Rectangle {
            x: 12px;
            y: 12px;
            width: fps-label.preferred-width + 16px;
            height: 26px;
            border-radius: 6px;
            background: #000000b3;

            fps-label := Text {
                x: 8px;
                height: 100%;
                text: root.fps-text;
                color: #7cffb2;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

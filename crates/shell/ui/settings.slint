import { SettingRow } from "types.slint";
import { Theme } from "theme.slint";

// Settings: a list of rows; ◀ ▶ changes the value of the focused row. The list scrolls when it
// does not fit above the hint bar, so the focused row stays visible.
export component SettingsPage inherits Rectangle {
    in property <[SettingRow]> rows;
    in property <int> focused;
    in property <string> footer;
    in property <float> s;

    property <length> margin: 110px * root.s;
    property <length> row-height: 92px * root.s;
    property <length> pitch: root.row-height + 12px * root.s;
    property <length> list-top: 200px * root.s;
    // Ends a little above the hint bar
    property <length> list-height: root.height - root.list-top - 150px * root.s;
    // The rows, the footer and some room below the last row
    property <length> content-height: root.rows.length * root.pitch + 110px * root.s;
    // Scrolls so that the row after the focused one is fully visible as well
    property <length> scroll: max(0px, min((root.focused + 2) * root.pitch + 10px * root.s - root.list-height, root.content-height - root.list-height));
    animate scroll {
        duration: Theme.focus-duration;
        easing: ease-out-quart;
    }

    Text {
        x: root.margin;
        y: 120px * root.s;
        text: @tr("Settings");
        color: Theme.text;
        font-size: 44px * root.s;
        font-weight: 800;
    }

    list := Rectangle {
        y: root.list-top;
        height: root.list-height;
        clip: true;

        for row[i] in root.rows: card := Rectangle {
            property <bool> is-focused: i == root.focused;
            x: root.margin;
            y: 10px * root.s + i * root.pitch - root.scroll;
            width: min(980px * root.s, root.width - 2 * root.margin);
            height: root.row-height;
            border-radius: 18px * root.s;
            background: self.is-focused ? Theme.accent : Theme.surface;
            animate background { duration: Theme.focus-duration; }

            VerticalLayout {
                x: 30px * root.s;
                y: (parent.height - self.height) / 2;
                height: self.preferred-height;
                spacing: 4px * root.s;

                Text {
                    text: row.label;
                    color: card.is-focused ? Theme.base : Theme.text;
                    font-size: 24px * root.s;
                    font-weight: 700;
                }

                Text {
                    text: row.description;
                    color: card.is-focused ? Theme.base.with-alpha(0.7) : Theme.text-dim;
                    font-size: 17px * root.s;
                }
            }

            Text {
                x: parent.width - self.width - 30px * root.s;
                height: 100%;
                text: row.opens-page ? row.value + "   ›"
                    : (card.is-focused ? "◀  " : "") + row.value + (card.is-focused ? "  ▶" : "");
                color: card.is-focused ? Theme.base : Theme.text;
                font-size: 22px * root.s;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Text {
            x: root.margin;
            y: 10px * root.s + root.rows.length * root.pitch + 24px * root.s - root.scroll;
            text: root.footer;
            color: Theme.text-dim;
            font-size: 16px * root.s;
        }
    }
}

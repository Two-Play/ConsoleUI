// Eingabeunabhängige Aktionen; Rust bildet sie auf `consoleui_core::Action` ab.
export enum NavAction { up, down, left, right, confirm, back, menu }

export enum NetworkState { offline, ethernet, wifi }

export struct AppTile {
    title: string,
    subtitle: string,
    kind: string,
    action-label: string,
    monogram: string,
    // Nur bei Platzhalter-Covern ohne Icon
    show-monogram: bool,
    // Echtes Cover oder erzeugter Farbverlauf
    cover: image,
    icon: image,
    has-icon: bool,
    logo: image,
    has-logo: bool,
    accent: color,
}

import { AppTile } from "types.slint";
import { Theme } from "theme.slint";
import { TileRow } from "tilerow.slint";

// Kind, title (or logo), subtitle and buttons of an entry
component InfoBlock {
    in property <AppTile> tile;
    in property <bool> shown;
    in property <float> s;

    // Only a crossfade, no movement: the old text fades out quickly, the new one fades in a little
    // later, so the two hardly overlap and nothing jumps while the focus runs along the row.
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity {
        duration: root.shown ? Theme.focus-duration : Theme.focus-duration * 0.5;
        delay: root.shown ? Theme.focus-duration * 0.25 : 0ms;
        easing: ease-out-quad;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: start;
        spacing: 8px * root.s;

        Text {
            text: root.tile.kind;
            color: Theme.text-dim;
            font-size: 18px * root.s;
            font-weight: 600;
            letter-spacing: 3px * root.s;
        }

        if root.tile.has-logo: Image {
            height: 130px * root.s;
            source: root.tile.logo;
            image-fit: contain;
            horizontal-alignment: left;
        }

        if !root.tile.has-logo: Text {
            text: root.tile.title;
            color: Theme.text;
            font-size: 64px * root.s;
            font-weight: 800;
        }

        Text {
            text: root.tile.subtitle;
            color: root.tile.running ? Theme.charging : Theme.text-dim;
            font-size: 26px * root.s;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 20px * root.s;
            padding-top: 22px * root.s;

            Rectangle {
                width: 220px * root.s;
                height: 64px * root.s;
                border-radius: self.height / 2;
                background: Theme.accent;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.tile.action-label;
                    color: Theme.base;
                    font-size: 24px * root.s;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 64px * root.s;
                height: 64px * root.s;
                border-radius: self.height / 2;
                background: Theme.surface;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "•••";
                    color: Theme.text;
                    font-size: 20px * root.s;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Home: the recently used apps and the library tile at the end, below them info on the selection.
export component HomePage inherits Rectangle {
    in property <[AppTile]> tiles;
    in property <int> focused;
    in property <bool> pulse;
    in property <float> s;

    out property <length> focus-x: row.focus-x;
    out property <length> focus-y: row.focus-y;
    out property <length> focus-size: row.focus-size;

    property <length> margin: 110px * root.s;
    property <AppTile> current: root.tiles[root.focused];

    row := TileRow {
        x: root.margin;
        y: 150px * root.s;
        tiles: root.tiles;
        focused: root.focused;
        pulse: root.pulse;
        tile: 150px * root.s;
        tile-focused: 230px * root.s;
        gap: 20px * root.s;
    }

    // Info on the focused entry: when the focus moves, the old text fades out and the new one in. The layer being shown follows `current` live, the other one keeps the
    // previous entry while it fades.
    property <bool> flip;
    property <AppTile> last: root.current;
    property <AppTile> previous;

    changed focused => {
        root.previous = root.last;
        root.last = root.current;
        root.flip = !root.flip;
    }

    for layer in 2: InfoBlock {
        property <bool> shows: (layer == 0) == root.flip;
        x: root.margin;
        y: row.y + row.height + 56px * root.s;
        width: root.width - 2 * root.margin;
        height: root.height - self.y;
        tile: self.shows ? root.current : root.previous;
        shown: self.shows;
        s: root.s;
    }
}

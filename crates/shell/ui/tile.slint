import { AppTile } from "types.slint";
import { Theme } from "theme.slint";

// An app tile. The home screen sets size and position; the tile only animates its looks.
export component Tile inherits Rectangle {
    in property <AppTile> data;
    in property <bool> focused;
    // Confirm was pressed on this tile: a ring ripples outwards after the press.
    in property <bool> pressed;

    // 0 → 1 once when the tile gets the focus: a light sweeps across the cover. Back to 0
    // without animation.
    property <float> sheen: root.focused ? 1 : 0;
    animate sheen {
        delay: root.focused ? Theme.focus-duration * 0.4 : 0ms;
        duration: root.focused ? Theme.focus-duration * 4 : 0ms;
        easing: ease-in-out;
    }
    // 0 at the press (instantly), then back to 1 (idle) while the ring fades out.
    property <float> ripple: root.pressed ? 0 : 1;
    animate ripple {
        duration: root.pressed ? 0ms : Theme.launch-duration * 1.4;
        easing: ease-out-quad;
    }
    // Gap between the tile and its focus ring
    property <length> ring-gap: max(3px, root.width * 0.035);

    border-radius: self.width * 0.12;
    background: root.data.accent;
    drop-shadow-blur: root.focused ? self.width * 0.2 : self.width * 0.05;
    drop-shadow-offset-y: root.focused ? 0px : self.width * 0.03;
    drop-shadow-color: root.focused ? root.data.accent.with-alpha(0.85) : #0000008c;
    animate drop-shadow-blur, drop-shadow-offset-y, drop-shadow-color {
        duration: Theme.focus-duration;
        easing: ease-out-quart;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: root.data.cover;
            image-fit: cover;
        }

        if root.data.has-icon: Image {
            width: parent.width * 0.58;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.data.icon;
            image-fit: contain;
        }

        if root.data.show-monogram: Text {
            width: 100%;
            height: 100%;
            text: root.data.monogram;
            color: #ffffffe6;
            font-size: root.width * 0.42;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Glass: a soft light from the top edge gives the flat covers some depth.
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #ffffff26 0%, #ffffff00 38%, #00000000 70%, #00000038 100%);
        }

        // The sweep of light after the focus arrives
        if root.focused && root.sheen > 0 && root.sheen < 1: Rectangle {
            x: (root.sheen * 2.4 - 1.2) * root.width;
            width: root.width * 0.9;
            height: 100%;
            background: @linear-gradient(110deg, #ffffff00 25%, #ffffff40 50%, #ffffff00 75%);
        }
    }

    if root.data.running: Rectangle {
        x: root.width * 0.07;
        y: root.width * 0.07;
        height: max(14px, root.width * 0.11);
        width: badge.preferred-width + self.height;
        border-radius: self.height / 2;
        background: #000000c0;

        badge := Text {
            width: 100%;
            height: 100%;
            text: "● " + @tr("RUNNING");
            color: Theme.charging;
            font-size: max(8px, root.width * 0.055);
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Pin at the top right for pinned entries
    if root.data.pinned: Rectangle {
        property <length> size: max(14px, root.width * 0.15);
        x: root.width - self.size - root.width * 0.07;
        y: root.width * 0.07;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: #000000c0;

        Image {
            width: parent.size * 0.62;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/pin.svg");
            colorize: Theme.accent;
        }
    }

    // Focus ring with a small gap around the tile
    Rectangle {
        x: -root.ring-gap;
        y: -root.ring-gap;
        width: root.width + 2 * root.ring-gap;
        height: root.height + 2 * root.ring-gap;
        border-radius: root.border-radius + root.ring-gap;
        border-color: Theme.accent;
        border-width: max(2px, root.width * 0.018);
        opacity: root.focused ? 1 : 0;
        animate opacity {
            duration: Theme.focus-duration;
            easing: ease-out-quart;
        }
    }

    // Ripple after a press
    if root.ripple < 1: Rectangle {
        property <length> grow: root.width * 0.22 * root.ripple;
        x: -root.ring-gap - self.grow;
        y: -root.ring-gap - self.grow;
        width: root.width + 2 * (root.ring-gap + self.grow);
        height: root.height + 2 * (root.ring-gap + self.grow);
        border-radius: root.border-radius + root.ring-gap + self.grow;
        border-color: Theme.accent;
        border-width: max(2px, root.width * 0.025) * (1 - root.ripple * 0.6);
        opacity: 0.9 * (1 - root.ripple);
    }
}

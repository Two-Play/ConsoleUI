import { AppTile } from "types.slint";
import { Theme } from "theme.slint";

// An app tile. The home screen sets size and position; the tile only animates its looks.
export component Tile inherits Rectangle {
    in property <AppTile> data;
    in property <bool> focused;

    border-radius: self.width * 0.12;
    background: root.data.accent;
    drop-shadow-blur: root.focused ? self.width * 0.2 : self.width * 0.05;
    drop-shadow-offset-y: root.focused ? 0px : self.width * 0.03;
    drop-shadow-color: root.focused ? root.data.accent.with-alpha(0.85) : #0000008c;
    animate drop-shadow-blur, drop-shadow-offset-y, drop-shadow-color {
        duration: Theme.focus-duration;
        easing: ease-out-quart;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: root.data.cover;
            image-fit: cover;
        }

        if root.data.has-icon: Image {
            width: parent.width * 0.58;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.data.icon;
            image-fit: contain;
        }

        if root.data.show-monogram: Text {
            width: 100%;
            height: 100%;
            text: root.data.monogram;
            color: #ffffffe6;
            font-size: root.width * 0.42;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if root.data.running: Rectangle {
        x: root.width * 0.07;
        y: root.width * 0.07;
        height: max(14px, root.width * 0.11);
        width: badge.preferred-width + self.height;
        border-radius: self.height / 2;
        background: #000000c0;

        badge := Text {
            width: 100%;
            height: 100%;
            text: "● " + @tr("RUNNING");
            color: Theme.charging;
            font-size: max(8px, root.width * 0.055);
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Pin at the top right for pinned entries
    if root.data.pinned: Rectangle {
        property <length> size: max(14px, root.width * 0.15);
        x: root.width - self.size - root.width * 0.07;
        y: root.width * 0.07;
        width: self.size;
        height: self.size;
        border-radius: self.size / 2;
        background: #000000c0;

        Image {
            width: parent.size * 0.62;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/pin.svg");
            colorize: Theme.accent;
        }
    }

    // Focus frame
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        border-color: Theme.accent;
        border-width: root.focused ? max(2px, root.width * 0.016) : 0px;
        animate border-width { duration: Theme.focus-duration; }
    }
}

import { Theme } from "theme.slint";

// Eine Ebene des Hero-Hintergrunds. Etwas größer als das Fenster, damit sie mit dem Fokus seitlich
// mitwandern kann (Parallaxe, Story 6.3) und beim Einblenden aus einem leichten Zoom zurückgleitet.
// Animiert wird nur nach einer Änderung; im Ruhezustand zeichnet nichts neu. Mit „Animationen aus“
// sind alle Dauern 0 und Rust setzt `parallax` auf 0.
export component HeroLayer {
    in property <image> source;
    in property <bool> front;
    // -1 (Fokus ganz links) … 1 (ganz rechts)
    in property <float> parallax;

    // Überstand gegenüber dem Fenster; reicht für die Verschiebung um 3 % je Richtung.
    property <float> overscan: 1.06;
    property <float> zoom: 1.05;
    property <float> shift: root.parallax;
    animate shift {
        duration: Theme.background-duration * 1.6;
        easing: ease-out;
    }

    states [
        shown when root.front: {
            zoom: 1.0;
            in {
                animate zoom {
                    duration: Theme.background-duration * 3;
                    easing: ease-out;
                }
            }
            // Beim Ausblenden bleibt der Zoom stehen und springt erst unsichtbar zurück.
            out {
                animate zoom {
                    delay: Theme.background-duration;
                    duration: 1ms;
                }
            }
        }
    ]

    Image {
        width: root.width * root.overscan * root.zoom;
        height: root.height * root.overscan * root.zoom;
        // Fokus rechts → Hintergrund wandert nach links (Tiefenwirkung).
        x: (root.width - self.width) / 2 - root.shift * root.width * (root.overscan - 1) / 2;
        y: (root.height - self.height) / 2;
        source: root.source;
        image-fit: cover;
        opacity: root.front ? 1 : 0;
        animate opacity {
            duration: Theme.background-duration;
            easing: ease-in-out;
        }
    }
}

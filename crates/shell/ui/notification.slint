import { Theme } from "theme.slint";
import { Toast } from "toast.slint";

// Own transparent window for notices over running games. In gamescope, Rust sets STEAM_OVERLAY
// without STEAM_INPUT_FOCUS and makes the window narrower than the screen; then gamescope treats it
// as its notification window: always on top, but never with keyboard/controller focus. gamescope
// centers it and scales it to the screen height, so the window is almost as large as the screen
// and the notice sits in its top right corner. In our own compositor the title (announced as
// `WindowRole::Notification`, Story 7.6) makes it the topmost window without any input; it has the
// output size there.
export component NotificationWindow inherits Window {
    // Must match NOTIFICATION_TITLE in src/compositor.rs
    title: "ConsoleUI notification";
    no-frame: true;
    background: transparent;

    // Fixed size (Rust sets it from the root size). Otherwise gamescope resizes windows without
    // STEAM_GAME to the screen size; only with min = max in the size hints it stays narrower.
    in property <length> window-width: 1px;
    in property <length> window-height: 1px;
    width: root.window-width;
    height: root.window-height;

    in property <bool> shown;
    in property <string> symbol;
    in property <string> title-text;
    in property <string> text;

    property <float> s: max(0.4, min(root.width / 1920px, root.height / 1080px));
    property <length> margin: 64px * s;

    Toast {
        x: root.width - root.margin - self.width + (root.shown ? 0 : 60px * root.s);
        y: root.margin;
        animate x {
            duration: Theme.launch-duration;
            easing: ease-out-quart;
        }
        shown: root.shown;
        symbol: root.symbol;
        title: root.title-text;
        text: root.text;
        s: root.s;
    }
}

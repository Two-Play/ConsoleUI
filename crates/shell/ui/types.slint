export { NavAction, GlyphButton, ControllerStyle, Hint, AppTile, ContextItem, KeyCap, SettingRow, NetworkState } from "@consoleui/types.slint";
import { KeyCap, ContextItem } from "@consoleui/types.slint";

export enum Screen { home, library, settings, search }

// Quick menu item
export struct QuickItem {
    label: string,
    // Detail below the name, e.g. "30 %"
    value: string,
    // Symbol as text (monochrome), e.g. "⏻"
    symbol: string,
    // Volume: up/down adjusts
    adjustable: bool,
    // 0-100 for the bar, otherwise -1
    level: int,
}

// Row of the Wi-Fi or Bluetooth page
export struct NetRow {
    // Symbol as text (Bluetooth device kind, on/off)
    symbol: string,
    title: string,
    detail: string,
    // On the right, e.g. "On"
    value: string,
    // Wi-Fi signal 1-4, otherwise 0
    bars: int,
    secured: bool,
    // Highlight controllers
    gamepad: bool,
    // Connected
    active: bool,
    // Request running (connecting, pairing, ...)
    busy: bool,
    // Waiting for the second press to remove
    armed: bool,
}

// "Wi-Fi" or "Bluetooth" sub-page of the settings, including password entry
export struct NetView {
    open: bool,
    title: string,
    status: string,
    rows: [NetRow],
    focused: int,
    empty-title: string,
    empty-text: string,
    password-open: bool,
    password-ssid: string,
    password-text: string,
    keys: [KeyCap],
    key-focused: int,
}

// Tile of the profile screen (Story 5.7)
export struct ProfileTile {
    name: string,
    initial: string,
    color: color,
    // The profile the shell runs with right now
    current: bool,
    // The "Add profile" tile
    add: bool,
}

// "Who's playing?" / "Switch profile" screen with its menu, name entry and delete confirmation
export struct ProfileView {
    open: bool,
    title: string,
    tiles: [ProfileTile],
    focused: int,
    menu-title: string,
    menu-items: [ContextItem],
    menu-focused: int,
    name-open: bool,
    name-title: string,
    name-text: string,
    keys: [KeyCap],
    key-focused: int,
    // Question before deleting; empty while not asking
    confirm-text: string,
    // The active profile, for the avatar in the top bar
    active-name: string,
    active-initial: string,
    active-color: color,
}

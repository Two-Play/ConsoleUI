// Eingabeunabhängige Aktionen; Rust bildet sie auf `consoleui_core::Action` ab.
export enum NavAction { up, down, left, right, confirm, back, menu, search, secondary, prev-tab, next-tab, guide }

export enum NetworkState { offline, ethernet, wifi }

export enum Screen { home, library, settings, search }

// Welche Taste ein Hinweis zeigt; das Symbol hängt vom ControllerStyle ab.
export enum GlyphButton { dpad, updown, confirm, back, north, west, menu, guide, l1, r1, quit }

export enum ControllerStyle { keyboard, playstation, xbox }

export struct Hint {
    button: GlyphButton,
    label: string,
}

export struct AppTile {
    title: string,
    subtitle: string,
    kind: string,
    action-label: string,
    monogram: string,
    // Nur bei Platzhalter-Covern ohne Icon
    show-monogram: bool,
    // Echtes Cover oder erzeugter Farbverlauf
    cover: image,
    icon: image,
    has-icon: bool,
    logo: image,
    has-logo: bool,
    accent: color,
    running: bool,
}

// Taste der Bildschirmtastatur; Position und Breite in Tastenbreiten
export struct KeyCap {
    label: string,
    row: int,
    x: float,
    width: float,
}

// Eintrag im Quick-Menü
export struct QuickItem {
    label: string,
    // Zusatz unter dem Namen, z. B. „30 %“
    value: string,
    // Symbol als Text (einfarbig), z. B. „⏻“
    symbol: string,
    // Wartet auf die zweite Bestätigung (Ausschalten, Beenden …)
    armed: bool,
    // Lautstärke: Hoch/Runter regelt
    adjustable: bool,
    // 0–100 für den Balken, sonst -1
    level: int,
}

// Zeile der Einstellungsseite
export struct SettingRow {
    label: string,
    description: string,
    value: string,
    // Öffnet eine Unterseite (WLAN, Bluetooth) statt den Wert zu ändern
    opens-page: bool,
}

// Zeile der WLAN- bzw. Bluetooth-Seite
export struct NetRow {
    // Symbol als Text (Bluetooth-Geräteart, Ein/Aus)
    symbol: string,
    title: string,
    detail: string,
    // Rechts, z. B. „An“
    value: string,
    // WLAN-Signal 1–4, sonst 0
    bars: int,
    secured: bool,
    // Controller hervorheben
    gamepad: bool,
    // Verbunden
    active: bool,
    // Auftrag läuft (Verbinden, Koppeln …)
    busy: bool,
    // Wartet auf den zweiten Druck zum Entfernen
    armed: bool,
}

// Unterseite „WLAN“ oder „Bluetooth“ der Einstellungen, inklusive Passwort-Eingabe
export struct NetView {
    open: bool,
    title: string,
    status: string,
    rows: [NetRow],
    focused: int,
    empty-title: string,
    empty-text: string,
    password-open: bool,
    password-ssid: string,
    password-text: string,
    keys: [KeyCap],
    key-focused: int,
}

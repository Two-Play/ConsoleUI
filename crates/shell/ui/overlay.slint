import { ControllerStyle, NavAction, QuickItem } from "types.slint";
import { QuickMenu } from "quickmenu.slint";
import { Dialog } from "@consoleui/dialog.slint";

// Own transparent window for the quick menu. In gamescope, Rust sets STEAM_OVERLAY before it is
// shown; gamescope then puts it over the running game. In our own compositor the title (announced
// as `WindowRole::Overlay`, Story 7.6) makes the compositor stack it above the app in front and
// give it keyboard and pointer while the menu is open.
export component OverlayWindow inherits Window {
    // Must match OVERLAY_TITLE in src/compositor.rs
    title: "ConsoleUI Overlay";
    no-frame: true;
    background: transparent;
    forward-focus: keys;

    in property <bool> open;
    in property <string> title-text;
    in property <[QuickItem]> items;
    in property <int> focused;
    in property <ControllerStyle> controller-style;

    // A confirmation above the menu (Story 5.1: restart, power off, quit ...), the same dialog as in
    // the main window, which is hidden behind a running app
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <[string]> dialog-buttons;
    in property <int> dialog-focused;

    callback action(NavAction);
    // The pointer picked a quick menu card or a dialog button
    callback quick-clicked(int);
    callback dialog-clicked(int);

    // The bar at the bottom edge, full width, where it is in this frame: our compositor blurs
    // the game below it (Story 7.13).
    out property <length> panel-y: menu.panel-y;
    out property <length> panel-height: menu.panel-height;
    // The dialog card, likewise
    out property <length> dialog-x: dialog.panel-x;
    out property <length> dialog-y: dialog.panel-y;
    out property <length> dialog-width: dialog.panel-width;
    out property <length> dialog-height: dialog.panel-height;
    out property <length> dialog-radius: dialog.panel-radius;

    property <float> s: max(0.4, min(root.width / 1920px, root.height / 1080px));

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) { root.action(NavAction.left); return accept; }
            if (event.text == Key.RightArrow) { root.action(NavAction.right); return accept; }
            if (event.text == Key.UpArrow) { root.action(NavAction.up); return accept; }
            if (event.text == Key.DownArrow) { root.action(NavAction.down); return accept; }
            if (event.text == Key.Return || event.text == Key.Space) { root.action(NavAction.confirm); return accept; }
            if (event.text == Key.Escape || event.text == Key.Backspace) { root.action(NavAction.back); return accept; }
            if (event.text == Key.F1) { root.action(NavAction.guide); return accept; }
            reject
        }

        menu := QuickMenu {
            width: 100%;
            height: 100%;
            open: root.open;
            title: root.title-text;
            items: root.items;
            focused: root.focused;
            style: root.controller-style;
            s: root.s;
            card-clicked(i) => { root.quick-clicked(i); }
        }

        dialog := Dialog {
            width: 100%;
            height: 100%;
            open: root.dialog-open;
            title: root.dialog-title;
            text: root.dialog-text;
            buttons: root.dialog-buttons;
            focused: root.dialog-focused;
            style: root.controller-style;
            s: root.s;
            button-clicked(i) => { root.dialog-clicked(i); }
        }
    }
}

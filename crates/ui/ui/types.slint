// Types shared by all components of the design system and by Rust (the shell and apps map their
// input to them).

// Input-agnostic actions; Rust maps them to `consoleui_core::Action`.
export enum NavAction { up, down, left, right, confirm, back, menu, search, secondary, prev-tab, next-tab, guide, reposition }

// Which button a hint shows; the glyph depends on the ControllerStyle.
export enum GlyphButton { dpad, updown, confirm, back, north, west, menu, guide, l1, r1, r3, quit }

export enum NetworkState { offline, ethernet, wifi }

export enum ControllerStyle { keyboard, playstation, xbox }

export struct Hint {
    button: GlyphButton,
    label: string,
}

export struct AppTile {
    title: string,
    subtitle: string,
    kind: string,
    action-label: string,
    monogram: string,
    // Only for placeholder covers without an icon
    show-monogram: bool,
    // Real cover or generated gradient
    cover: image,
    icon: image,
    has-icon: bool,
    logo: image,
    has-logo: bool,
    accent: color,
    running: bool,
    // Pinned in the context menu: comes first in home and carries a pin
    pinned: bool,
    // A Steam game of the account that is not installed: dimmed, with a download mark
    not-installed: bool,
}

// Menu item (context menu, profile menu, ...)
export struct ContextItem {
    label: string,
    // Symbol as text (monochrome)
    symbol: string,
}

// On-screen keyboard key; position and width in key widths
export struct KeyCap {
    label: string,
    row: int,
    x: float,
    width: float,
}

// Row of a settings list
// What the `MediaPlayer` shows
export struct PlayerState {
    cover: image,
    has-cover: bool,
    source: string,
    title: string,
    artist: string,
    album: string,
    playing: bool,
    progress: float,
    time: string,
    length: string,
    focused: int,
    can-previous: bool,
    can-next: bool,
    has-shuffle: bool,
    shuffle: bool,
}

// A row of a `ControlPanel` (plugin panels, Epic 9)
export struct PanelRow {
    label: string,
    detail: string,
    value: string,
    // Toggle, slider or choice: ◀ ▶ change it
    adjustable: bool,
    // Confirm presses it
    button: bool,
    // Sliders: 0-100 for the bar, otherwise -1
    level: int,
}

export struct SettingRow {
    label: string,
    description: string,
    value: string,
    // Opens a sub-page (Wi-Fi, Bluetooth) instead of changing the value
    opens-page: bool,
}

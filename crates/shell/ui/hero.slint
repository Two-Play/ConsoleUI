import { Theme } from "@consoleui/theme.slint";

// One layer of the hero background. Slightly larger than the window, so it can move sideways
// with the focus (parallax, Story 6.3) and glide back from a slight zoom when fading in.
// It animates only after a change; at rest nothing redraws. With "Animations off" all
// durations are 0 and Rust sets `parallax` to 0.
export component HeroLayer {
    in property <image> source;
    in property <bool> front;
    // -1 (focus far left) … 1 (far right)
    in property <float> parallax;

    // Overhang beyond the window; enough for the shift of 3 % in each direction.
    property <float> overscan: 1.06;
    property <float> zoom: 1.05;
    property <float> shift: root.parallax;
    animate shift {
        duration: Theme.background-duration * 1.6;
        easing: ease-out;
    }

    states [
        shown when root.front: {
            zoom: 1.0;
            in {
                animate zoom {
                    duration: Theme.background-duration * 3;
                    easing: ease-out;
                }
            }
            // When fading out, the zoom stays and only jumps back while invisible.
            out {
                animate zoom {
                    delay: Theme.background-duration;
                    duration: 1ms;
                }
            }
        }
    ]

    Image {
        width: root.width * root.overscan * root.zoom;
        height: root.height * root.overscan * root.zoom;
        // Focus on the right → background moves to the left (depth effect).
        x: (root.width - self.width) / 2 - root.shift * root.width * (root.overscan - 1) / 2;
        y: (root.height - self.height) / 2;
        source: root.source;
        image-fit: cover;
        opacity: root.front ? 1 : 0;
        animate opacity {
            duration: Theme.background-duration;
            easing: ease-in-out;
        }
    }
}

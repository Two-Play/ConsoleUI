import { AppTile } from "types.slint";
import { Theme } from "theme.slint";
import { TileRow } from "tilerow.slint";

// Ring with a small gap around a round button that has the focus
component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <float> s;
    // Size of the button inside; the ring keeps a small gap around it
    in property <length> target-width;
    in property <length> target-height;
    property <length> gap: 5px * root.s;
    x: -self.gap;
    y: -self.gap;
    width: root.target-width + 2 * self.gap;
    height: root.target-height + 2 * self.gap;
    border-radius: self.height / 2;
    border-width: 3px * root.s;
    border-color: Theme.accent;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.focus-duration; }
}

// Kind, title (or logo), subtitle and buttons of an entry
component InfoBlock {
    in property <AppTile> tile;
    in property <bool> shown;
    in property <float> s;
    // The focused button (0: main action, 1: more options), -1 while the focus is elsewhere
    in property <int> button: -1;

    // Only a crossfade, no movement: the old text fades out quickly, the new one fades in a little
    // later, so the two hardly overlap and nothing jumps while the focus runs along the row.
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity {
        duration: root.shown ? Theme.focus-duration : Theme.focus-duration * 0.5;
        delay: root.shown ? Theme.focus-duration * 0.25 : 0ms;
        easing: ease-out-quad;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: start;
        spacing: 8px * root.s;

        Text {
            text: root.tile.kind;
            color: Theme.text-dim;
            font-size: 18px * root.s;
            font-weight: 600;
            letter-spacing: 3px * root.s;
        }

        // Logo or title in a box of one fixed height, so the lines and buttons below stay put
        // while the focus runs over entries with and without a logo.
        Rectangle {
            height: 130px * root.s;

            if root.tile.has-logo: Image {
                width: 100%;
                height: 100%;
                source: root.tile.logo;
                image-fit: contain;
                horizontal-alignment: left;
            }

            if !root.tile.has-logo: Text {
                width: 100%;
                height: 100%;
                text: root.tile.title;
                color: Theme.text;
                font-size: 64px * root.s;
                font-weight: 800;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Text {
            text: root.tile.subtitle;
            color: root.tile.running ? Theme.charging : Theme.text-dim;
            font-size: 26px * root.s;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 20px * root.s;
            padding-top: 22px * root.s;

            main := Rectangle {
                width: 220px * root.s;
                height: 64px * root.s;
                border-radius: self.height / 2;
                background: Theme.accent;

                FocusRing {
                    shown: root.button == 0;
                    s: root.s;
                    target-width: main.width;
                    target-height: main.height;
                }

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.tile.action-label;
                    color: Theme.base;
                    font-size: 24px * root.s;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            more := Rectangle {
                width: 64px * root.s;
                height: 64px * root.s;
                border-radius: self.height / 2;
                background: root.button == 1 ? Theme.text : Theme.surface;

                FocusRing {
                    shown: root.button == 1;
                    s: root.s;
                    target-width: more.width;
                    target-height: more.height;
                }

                Text {
                    width: 100%;
                    height: 100%;
                    text: "•••";
                    color: root.button == 1 ? Theme.base : Theme.text;
                    font-size: 20px * root.s;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Home: the recently used apps and the library tile at the end, below them info on the selection.
export component HomePage inherits Rectangle {
    in property <[AppTile]> tiles;
    in property <int> focused;
    in property <bool> pulse;
    in property <float> s;
    // Where the selection is: 0 the tile row, 1 the buttons, 2 the tabs (drawn by the main window)
    in property <int> area;
    in property <int> area-index;

    out property <length> focus-x: row.focus-x;
    out property <length> focus-y: row.focus-y;
    out property <length> focus-size: row.focus-size;

    property <length> margin: 110px * root.s;
    property <AppTile> current: root.tiles[root.focused];

    row := TileRow {
        x: root.margin;
        y: 150px * root.s;
        tiles: root.tiles;
        focused: root.focused;
        pulse: root.pulse;
        tile: 150px * root.s;
        tile-focused: 230px * root.s;
        gap: 20px * root.s;
        // One tile stays visible to the left of the focused one.
        lead: 1;
        ring: root.area == 0;
    }

    // Info on the focused entry: when the focus moves, the old text fades out and the new one in. The layer being shown follows `current` live, the other one keeps the
    // previous entry while it fades.
    property <bool> flip;
    property <AppTile> last: root.current;
    property <AppTile> previous;

    changed focused => {
        root.previous = root.last;
        root.last = root.current;
        root.flip = !root.flip;
    }

    for layer in 2: InfoBlock {
        property <bool> shows: (layer == 0) == root.flip;
        // Lines up with the focused tile, which always sits one tile to the right of the margin
        x: root.margin + row.tile + row.gap;
        y: row.y + row.height + 56px * root.s;
        width: root.width - 2 * root.margin - row.tile - row.gap;
        height: root.height - self.y;
        tile: self.shows ? root.current : root.previous;
        shown: self.shows;
        s: root.s;
        button: root.area == 1 && self.shows ? root.area-index : -1;
    }
}

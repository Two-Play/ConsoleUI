import { Theme } from "@consoleui/theme.slint";
import { ControllerStyle, GlyphButton, Hint, QuickItem } from "types.slint";
import { HintBar } from "@consoleui/glyph.slint";
import { GlassPanel } from "@consoleui/glass.slint";

// Quick menu: a bar of cards at the bottom edge with a slight darkening above. Used in the overlay
// window (gamescope) or as a layer of the main window.
export component QuickMenu inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <[QuickItem]> items;
    in property <int> focused;
    in property <ControllerStyle> style;
    in property <float> s: 1;

    callback card-clicked(int);

    property <QuickItem> current: root.items[root.focused];
    property <length> card: 170px * root.s;
    property <length> gap: 18px * root.s;
    // Height of the bar when open (the overlay window reports it to the compositor for the blur)
    out property <length> panel-height: 330px * root.s;
    // Where the bar is right now (animated); the compositor's blur follows it.
    out property <length> panel-y: panel.y;

    // Darkens the game above the bar only, so a blurred backdrop under the bar stays clear.
    Rectangle {
        y: 0;
        width: 100%;
        height: panel.y;
        background: Theme.base;
        opacity: root.open ? 0.55 : 0;
        animate opacity { duration: Theme.page-duration; }
    }

    panel := GlassPanel {
        y: root.open ? root.height - root.panel-height : root.height;
        width: 100%;
        height: root.panel-height;
        tint: #12141c;
        edge: false;
        opacity: root.open ? 1 : 0;
        animate y, opacity {
            duration: Theme.launch-duration;
            easing: ease-out-quart;
        }

        Rectangle {
            y: 0;
            width: 100%;
            height: 1px;
            background: #ffffff22;
        }

        Text {
            x: 110px * root.s;
            y: 26px * root.s;
            text: root.title;
            color: Theme.text-dim;
            font-size: 20px * root.s;
            font-weight: 600;
            letter-spacing: 2px * root.s;
        }

        for item[i] in root.items: card := Rectangle {
            property <bool> is-focused: i == root.focused;
            x: 110px * root.s + i * (root.card + root.gap);
            y: 70px * root.s + (self.is-focused ? 0 : 8px * root.s);
            width: root.card;
            height: root.card * 0.82;
            border-radius: 18px * root.s;
            background: self.is-focused ? Theme.accent : Theme.surface;
            // Only the lift animates: a fading background with the text color switched at once
            // left the card that loses the focus as a pale "ghost" for a moment.
            animate y { duration: Theme.focus-duration; easing: ease-out-quart; }

            TouchArea {
                clicked => { root.card-clicked(i); }
            }

            Text {
                x: 18px * root.s;
                y: 14px * root.s;
                text: item.symbol;
                color: card.is-focused ? Theme.base : Theme.text;
                font-size: 30px * root.s;
            }

            VerticalLayout {
                x: 18px * root.s;
                y: parent.height - self.height - 14px * root.s;
                width: parent.width - 36px * root.s;
                height: self.preferred-height;
                spacing: 2px * root.s;

                Text {
                    text: item.label;
                    color: card.is-focused ? Theme.base : Theme.text;
                    font-size: 17px * root.s;
                    font-weight: 700;
                    overflow: elide;
                }

                if item.level >= 0: Rectangle {
                    height: 6px * root.s;
                    border-radius: 3px * root.s;
                    background: #00000033;

                    Rectangle {
                        x: 0;
                        width: parent.width * item.level / 100;
                        border-radius: parent.border-radius;
                        background: card.is-focused ? Theme.base : Theme.text;
                    }
                }

                if item.value != "": Text {
                    text: item.value;
                    color: card.is-focused ? Theme.base.with-alpha(0.7) : Theme.text-dim;
                    font-size: 14px * root.s;
                    overflow: elide;
                }
            }
        }

        HintBar {
            x: 110px * root.s;
            y: root.panel-height - 62px * root.s;
            height: 28px * root.s;
            style: root.style;
            s: root.s;
            hints: root.current.adjustable ? [{ button: GlyphButton.dpad, label: @tr("Select") }, { button: GlyphButton.updown, label: @tr("Volume") }, { button: GlyphButton.confirm, label: @tr("Mute") }, { button: GlyphButton.back, label: @tr("Close") }]
                : [{ button: GlyphButton.dpad, label: @tr("Select") }, { button: GlyphButton.confirm, label: @tr("OK") }, { button: GlyphButton.back, label: @tr("Close") }];
        }
    }
}

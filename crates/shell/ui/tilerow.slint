import { AppTile } from "types.slint";
import { Theme } from "theme.slint";
import { Tile } from "tile.slint";

// Horizontal tile row: the focused tile stays near the left, the row slides through below it.
export component TileRow inherits Rectangle {
    in property <[AppTile]> tiles;
    in property <int> focused;
    in property <bool> pulse;
    // Without an active row (e.g. keyboard in the search) no tile is highlighted.
    in property <bool> active: true;
    // The focused tile shows its ring (off while the selection is on the buttons or tabs)
    in property <bool> ring: true;
    in property <length> tile;
    in property <length> tile-focused;
    in property <length> gap;
    // Room left of the focused tile for this many tiles; it stays reserved at the first tile, so
    // the focused tile (and the info below it) always sits at the same place
    in property <int> lead: 0;

    property <length> lead-x: root.lead * (root.tile + root.gap);

    // Position of the focused tile relative to the parent, for the launch screen
    out property <length> focus-x: root.x + root.lead-x;
    out property <length> focus-y: root.y;
    out property <length> focus-size: root.tile-focused;

    height: root.tile-focused;

    for app[i] in root.tiles: Tile {
        property <bool> is-focused: root.active && i == root.focused;
        property <length> base: self.is-focused ? root.tile-focused : root.tile;
        property <length> size: root.pulse && self.is-focused ? self.base * 0.94 : self.base;

        data: app;
        focused: self.is-focused;
        ring: root.ring;
        pressed: root.pulse && self.is-focused;
        width: self.size;
        height: self.size;
        x: root.lead-x + (i - root.focused) * (root.tile + root.gap) + (i > root.focused && root.active ? root.tile-focused - root.tile : 0px) + (self.base - self.size) / 2;
        y: (self.base - self.size) / 2;

        animate x, y, width, height {
            duration: Theme.focus-duration;
            easing: ease-out-quart;
        }
    }
}

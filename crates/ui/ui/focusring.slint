import { Theme } from "theme.slint";

// The outline of a list entry, card or button: the accent color while the entry has the focus.
// With the "Focus glow" setting (`Theme.focus-glow`) a soft halo breathes around it, slowly, like
// the selection on a PS5; otherwise it stays a calm outline that costs no redraws. Put it last in
// the rounded entry and give it the entry's `border-radius`; it fills its parent. Without
// animations (all durations 0) the halo stands still.
export component FocusRing inherits Rectangle {
    in property <bool> focused;
    in property <float> s: 1;
    in property <color> highlight: Theme.accent;

    property <length> bw: (root.focused ? 3 : 2) * root.s * 1px;
    property <bool> halo: root.focused && Theme.focus-glow;
    // 0 → 1 → 0 every few seconds while the halo shows
    property <float> breath: root.halo && Theme.focus-duration > 0ms
        ? 0.5 + 0.5 * Math.sin(animation-tick() / 2800ms * 360deg)
        : 0.6;

    border-width: root.bw;
    border-color: root.focused ? root.highlight.with-alpha(root.halo ? 0.6 + 0.3 * root.breath : 0.45) : Theme.line-strong;
    animate border-color, border-width { duration: Theme.focus-duration * 0.4; easing: ease-out-quint; }

    if root.halo: Rectangle {
        opacity: 1;
        // Rings that grow fainter outwards: a light that spreads, not a second frame
        for i in 4: Rectangle {
            property <length> grow: (i + 1) * 2.4px * root.s;
            x: -self.grow;
            y: -self.grow;
            width: root.width + 2 * self.grow;
            height: root.height + 2 * self.grow;
            border-radius: root.border-radius + self.grow;
            border-width: 2.6px * root.s;
            border-color: root.highlight.with-alpha((0.34 - i * 0.075) * (0.35 + 0.65 * root.breath));
        }
    }
}

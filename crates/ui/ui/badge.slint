import { Theme } from "theme.slint";

// Small status label on a dark pill, e.g. "● RUNNING", "NEW" or "62 %".
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text;
    in property <float> s: 1;

    height: 24px * root.s;
    width: label.preferred-width + 20px * root.s;
    border-radius: self.height / 2;
    background: #000000c0;

    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: root.tint;
        font-size: 12px * root.s;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

import { AppTile, Badge, Button, ControllerStyle, Dialog, EmptyState, Hint, HintBar, InputScope, KeyCap, KeyboardPanel, NavAction, ProgressBar, Spinner, TabBar, Theme, Tile } from "@consoleui/std.slint";

// Rust needs the global to apply the user's accent color and animation settings
export { Theme }

export struct StoreDetail {
    open: bool,
    tile: AppTile,
    developer: string,
    summary: string,
    description: string,
    gamepad: bool,
    verified: bool,
    installed: bool,
    // Text next to the progress, empty while nothing runs
    status: string,
    // 0…1, below 0 while nothing is known
    progress: float,
    buttons: [string],
    button: int,
    scroll: int,
}

export component AppWindow inherits Window {
    in property <[AppTile]> tiles;
    in property <int> focused;
    in property <int> section;
    in property <string> position;
    in property <bool> loading: true;
    in property <string> error;
    in property <string> empty-title;
    in property <string> empty-text;
    in property <StoreDetail> detail;
    in property <bool> typing;
    in property <string> query;
    in property <[KeyCap]> keys;
    in property <int> key-focused;
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-text;
    in property <[string]> dialog-buttons;
    in property <int> dialog-focused;
    in property <[Hint]> hints;
    in property <ControllerStyle> style: ControllerStyle.keyboard;
    out property <bool> active: scope.active;
    out property <int> max-scroll: max(0, ceil((description.preferred-height - description-box.height) / root.scroll-step));
    callback action(NavAction);
    callback typed(string);
    callback erase();
    callback tab-clicked(int);
    callback tile-clicked(int);
    callback button-clicked(int);
    callback dialog-clicked(int);
    callback quit();

    title: @tr("Store");
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.base;

    // All sizes are for 1920×1080 and scale with the window
    property <float> s: min(self.width / 1920px, self.height / 1080px);
    property <length> margin: 90px * root.s;
    property <length> tile: 200px * root.s;
    property <length> gap: (root.width - 2 * root.margin - 7 * root.tile) / 6;
    property <length> row-height: 270px * root.s;
    property <length> scroll-step: 120px * root.s;

    scope := InputScope {
        typing: root.typing;
        action(a) => { root.action(a); }
        typed(text) => { root.typed(text); }
        erase => { root.erase(); }
        quit => { root.quit(); }
    }

    TabBar {
        x: root.margin;
        y: 50px * root.s;
        tabs: [@tr("Games"), @tr("Apps"), @tr("Installed")];
        current: root.section;
        style: root.style;
        s: root.s;
        clicked(i) => { root.tab-clicked(i); }
    }

    Text {
        x: root.width - root.margin - self.width;
        y: 56px * root.s;
        width: 400px * root.s;
        horizontal-alignment: right;
        text: root.position;
        color: Theme.text-dim;
        font-size: 22px * root.s;
    }

    for app[i] in root.tiles: Rectangle {
        property <bool> is-focused: i == root.focused && !root.typing;
        x: root.margin + mod(i, 7) * (root.tile + root.gap);
        y: 130px * root.s + floor(i / 7) * root.row-height;
        width: root.tile;
        height: root.row-height;

        Tile {
            property <length> size: root.tile * (parent.is-focused ? 1 : 0.9);
            x: (root.tile - self.size) / 2;
            y: (root.tile - self.size) / 2;
            width: self.size;
            height: self.size;
            data: app;
            focused: parent.is-focused;
            animate x, y, width, height {
                duration: Theme.focus-duration;
                easing: ease-out-quart;
            }
        }

        TouchArea {
            width: root.tile;
            height: root.tile;
            clicked => { root.tile-clicked(i); }
        }

        Text {
            y: root.tile + 10px * root.s;
            width: root.tile;
            text: app.title;
            color: parent.is-focused ? Theme.text : Theme.text-dim;
            font-size: 18px * root.s;
            font-weight: parent.is-focused ? 700 : 400;
            overflow: elide;
            horizontal-alignment: center;
        }

        Text {
            y: root.tile + 34px * root.s;
            width: root.tile;
            text: app.subtitle;
            color: Theme.text-dim;
            font-size: 14px * root.s;
            overflow: elide;
            horizontal-alignment: center;
        }
    }

    if root.loading: VerticalLayout {
        alignment: center;
        spacing: 20px * root.s;

        HorizontalLayout {
            alignment: center;
            Spinner { size: 56px * root.s; s: root.s; }
        }

        Text {
            horizontal-alignment: center;
            text: @tr("Loading the catalog…");
            color: Theme.text-dim;
            font-size: 24px * root.s;
        }
    }

    if !root.loading && root.tiles.length == 0: EmptyState {
        x: root.margin;
        y: 130px * root.s;
        width: root.width - 2 * root.margin;
        height: root.height - 240px * root.s;
        title: root.empty-title;
        text: root.empty-text;
        s: root.s;
    }

    Rectangle {
        visible: root.detail.open;
        background: Theme.base;

        TouchArea { }

        Tile {
            x: root.margin;
            y: 80px * root.s;
            width: 280px * root.s;
            height: self.width;
            data: root.detail.tile;
            ring: false;
        }

        info := VerticalLayout {
            x: root.margin + 340px * root.s;
            y: 70px * root.s;
            width: root.width - self.x - root.margin;
            height: 310px * root.s;
            alignment: start;
            spacing: 12px * root.s;

            Text {
                text: root.detail.tile.title;
                color: Theme.text;
                font-size: 56px * root.s;
                font-weight: 800;
                overflow: elide;
            }

            Text {
                text: root.detail.developer;
                color: Theme.text-dim;
                font-size: 24px * root.s;
                overflow: elide;
            }

            Text {
                text: root.detail.summary;
                color: Theme.text;
                font-size: 26px * root.s;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: start;
                spacing: 10px * root.s;
                height: 24px * root.s;

                if root.detail.installed: Badge { text: @tr("INSTALLED"); tint: Theme.charging; s: root.s; }
                if root.detail.gamepad: Badge { text: @tr("CONTROLLER"); tint: Theme.accent; s: root.s; }
                if root.detail.verified: Badge { text: @tr("VERIFIED"); s: root.s; }
            }

            Rectangle { height: 8px * root.s; }

            HorizontalLayout {
                alignment: start;
                spacing: 16px * root.s;
                height: 58px * root.s;

                for label[i] in root.detail.buttons: Button {
                    text: label;
                    focused: i == root.detail.button;
                    s: root.s;
                    clicked => { root.button-clicked(i); }
                }

                if root.detail.status != "": Text {
                    vertical-alignment: center;
                    text: root.detail.status;
                    color: Theme.text;
                    font-size: 24px * root.s;
                }

                if root.detail.status != "" && root.detail.progress < 0: Spinner {
                    y: (parent.height - self.height) / 2;
                    size: 36px * root.s;
                    s: root.s;
                }

                if root.detail.progress >= 0: VerticalLayout {
                    alignment: center;

                    ProgressBar {
                        width: 420px * root.s;
                        value: root.detail.progress;
                        fill: Theme.accent;
                        s: root.s;
                    }
                }
            }
        }

        description-box := Rectangle {
            x: root.margin;
            y: 400px * root.s;
            width: root.width - 2 * root.margin;
            height: root.height - self.y - 110px * root.s;
            clip: true;

            description := Text {
                x: 0;
                y: -min(root.detail.scroll * root.scroll-step, max(0px, self.preferred-height - parent.height));
                width: min(parent.width, 1300px * root.s);
                height: self.preferred-height;
                text: root.detail.description;
                color: Theme.text-dim;
                font-size: 24px * root.s;
                wrap: word-wrap;
                animate y {
                    duration: Theme.focus-duration;
                    easing: ease-out-quart;
                }
            }
        }
    }

    HintBar {
        visible: !root.typing;
        x: root.margin;
        y: root.height - 70px * root.s;
        width: root.width - 2 * root.margin;
        height: 28px * root.s;
        hints: root.hints;
        style: root.style;
        s: root.s;
    }

    KeyboardPanel {
        width: 100%;
        height: 100%;
        open: root.typing;
        text: root.query;
        placeholder: @tr("Search the store");
        keys: root.keys;
        focused: root.key-focused;
        hints: root.hints;
        style: root.style;
        s: root.s;
    }

    Dialog {
        width: 100%;
        height: 100%;
        open: root.dialog-open;
        title: root.dialog-title;
        text: root.dialog-text;
        buttons: root.dialog-buttons;
        focused: root.dialog-focused;
        style: root.style;
        s: root.s;
        button-clicked(index) => { root.dialog-clicked(index); }
    }
}

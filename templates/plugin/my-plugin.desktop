[Desktop Entry]
Type=Application
Name=My Plugin
Comment=A plugin for ConsoleUI
Icon=applications-other
Exec=my-plugin
# A plugin is no app: desktop menus and the shell's library leave it out
NoDisplay=true
# The bus name it owns; with Flatpak the app ID, which a sandbox may own without extra rights
X-ConsoleUI-Plugin=@APP_ID@
# What it offers: library (entries), panel (quick menu), settings (its page), artwork, themes;
# remove what you do not use
X-ConsoleUI-Plugin-Provides=library;panel;settings;

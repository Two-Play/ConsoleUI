#!/bin/sh
# Simulates the console session in a window on the desktop, for testing without logging out.
#
# Default: gamescope runs nested in Steam mode, and everything the shell starts opens in this
# window (the programs only see gamescope's XWayland).
# --compositor: our own compositor (Epic 7) runs nested instead (consoleui-compositor --winit).
#
#   session/consoleui-nested                       # 1920×1080, release build from this repo
#   session/consoleui-nested --dummy               # options go to the shell
#   session/consoleui-nested --compositor --dummy  # own compositor instead of gamescope
#   CONSOLEUI_GAMESCOPE_ARGS="-W 2560 -H 1440" session/consoleui-nested
set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"
export CONSOLEUI_BIN="${CONSOLEUI_BIN:-$root/target/release/consoleui}"
export CONSOLEUI_GAMESCOPE_ARGS="${CONSOLEUI_GAMESCOPE_ARGS:--W 1920 -H 1080}"

if [ ! -x "$CONSOLEUI_BIN" ]; then
    echo "Run 'cargo build --release' first." >&2
    exit 1
fi
# A Steam already running takes steam:// calls and opens games on the desktop.
if pgrep -x steam >/dev/null; then
    echo "Note: Steam is already running on the desktop; Steam games then open there." >&2
    echo "      Quit Steam before the test, then it starts inside the session." >&2
fi

if [ "${1:-}" = "--compositor" ]; then
    shift
    compositor="${CONSOLEUI_COMPOSITOR_BIN:-$root/target/toolbox/release/consoleui-compositor}"
    if [ ! -x "$compositor" ]; then
        echo "Run 'dev/toolbox.sh run cargo build --release -p consoleui-compositor' first." >&2
        exit 1
    fi
    exec "$compositor" --winit --size 1920x1080 -- "$CONSOLEUI_BIN" "$@"
fi

exec "$root/session/consoleui-session" "$@"

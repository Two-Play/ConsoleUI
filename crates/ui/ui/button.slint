import { Theme } from "theme.slint";
import { FocusFill } from "focusfill.slint";
import { FocusRing } from "focusring.slint";

// The standard button: a rounded pill with an outline. While it has the focus the accent color
// fades in (see `FocusFill`). Focus comes from Rust (gamepad navigation), not from Slint's focus
// handling.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> focused;
    in property <float> s: 1;

    callback clicked();

    min-width: 150px * root.s;
    preferred-width: label.preferred-width + 56px * root.s;
    height: 58px * root.s;
    border-radius: Theme.radius-button * root.s;
    background: Theme.surface.with-alpha(0.08);

    fill := FocusFill {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        focused: root.focused;
    }

    FocusRing {
        border-radius: root.border-radius;
        focused: root.focused;
        s: root.s;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }

    label := Text {
        text: root.text;
        color: Theme.text;
        font-size: 24px * root.s;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}
